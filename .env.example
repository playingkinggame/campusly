# Copy this file to ".env.local" (same folder) and fill in your own values.
# Find both in Supabase: Project Settings -> API.
# Use the "anon" / "publishable" key ONLY. Never put the service_role / secret key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Cloudflare Turnstile SITE key (public). Required once CAPTCHA protection is
# enabled in Supabase: Authentication -> Bot and Abuse Protection.
# The Turnstile SECRET key goes in Supabase only, never in this file or the site.
VITE_TURNSTILE_SITE_KEY=
